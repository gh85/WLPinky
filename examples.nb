Cell[CellGroupData[{

Cell["Dragon-Graphics", "Chapter",
 CellChangeTimes->{{3.9863226622642746`*^9, 
  3.9863226774115257`*^9}},ExpressionUUID->"9766ce4d-9f27-2043-a182-\
2e1104013819"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"SetSystemOptions", "[", 
     RowBox[{"\"\<CheckMachineUnderflow\>\"", "\[Rule]", "False"}], "]"}], 
    ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"$RecursionLimit", "=", "Infinity"}], "}"}], ","}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
  "PinkyInterPreter", 
   "[", "\"\<\n\nangle := 0\nx := 25\ny := 60\n\nfunc pow(base, exponent)\n  \
ret base ^ exponent\nend\n\nfunc factorial(n)\n  res := 1.0\n  for i := 1, n \
do\n    res := res * i\n  end\n  ret res\nend\n\nfunc cos(a)\n\n  a := a % \
360\n  if a == 0   then ret  1.0 end\n  if a == 90  then ret 0.0 end\n  if a \
== 180 then ret -1.0 end\n  if a == 270 then ret  0.0 end\n  if a == 360 then \
ret  1.0 end\n  ret -99999\nend\n\nfunc sin(a)\na := a % 360\n  if a == 0   \
then ret  0.0 end\n  if a == 90  then ret  1.0 end\n  if a == 180 then ret  \
0.0 end\n  if a == 270 then ret -1.0 end\n  if a == 360 then ret  0.0 end\n  \
ret -99999\nend\n\nfunc dragon(size, level, d)\n  if level == 0 then\n    x \
:= x - cos(angle) * size\n    y := y + sin(angle) * size\n    print('{' + x + \
',' + y+'},')\n  else\n    dragon(size / 1.4142135624, level - 1, 1)\n    \
angle := angle - d * 90\n    dragon(size / 1.4142135624, level - 1, -1)\n  \
end\nend\nprint '{'\ndragon(6, 12, 1)\nprint '{0,0}}'\n\n\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"a7757e11-596b-814e-8738-ef177a8f271a"],

