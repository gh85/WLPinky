Cell["\<\
  def get_var(self, name):
 
    while self:
      value = self.vars.get(name)
      if value is not None:
        return value
      else:
        self = self.parent
    return None
    
    
     def get_func(self, name):

    while self:
      value = self.funcs.get(name)
      if value is not None:
        return value
      else:
        self = self.parent 
    return None\
\>", "Text",
